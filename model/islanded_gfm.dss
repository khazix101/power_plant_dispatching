Clear
Set DefaultBaseFrequency=50

! Single highway-service microgrid islanded QSTS model.
! OpenDSS's Circuit Vsource is relocated by the external GFM controller to
! Storage_Bus and acts only as a numerical Vtheta reference. Its net complex
! power must equal the GFM BESS injection; it is not allowed to supply energy.
New Circuit.HighwayServiceIsland bus1=MainBus basekV=0.4 pu=1.0 phases=3

! Typical LV cable prior for a 0.4-kV service-area feeder:
! R1=0.125 ohm/km, X1=0.08 ohm/km. Replace with the station cable schedule
! before reporting site-specific voltage drop or thermal-limit compliance.
New LineCode.LV_Cable nphases=3 r1=0.125 x1=0.08 r0=0.125 x0=0.08 units=km

New Line.PV_Line bus1=MainBus bus2=PV_Bus linecode=LV_Cable length=0.05 units=km
New Generator.PV1 bus1=PV_Bus phases=3 kV=0.4 kW=0 model=1

New Line.Wind_Line bus1=MainBus bus2=Wind_Bus linecode=LV_Cable length=0.05 units=km
New Generator.Wind1 bus1=Wind_Bus phases=3 kV=0.4 kW=0 model=1

New Line.Load_Line bus1=MainBus bus2=Load_Bus linecode=LV_Cable length=0.05 units=km
New Load.EVLoad bus1=Load_Bus phases=3 kV=0.4 kW=0 model=1

New Line.Storage_Line bus1=MainBus bus2=Storage_Bus linecode=LV_Cable length=0.05 units=km
New Storage.Storage1 bus1=Storage_Bus phases=3 kV=0.4 kWrated=800 kVA=1000 kWhrated=2000 %stored=50 %reserve=20 %EffCharge=95 %EffDischarge=95 %IdlingkW=0 DispMode=EXTERNAL state=idling

Set Voltagebases=[0.4]
CalcVoltageBases
